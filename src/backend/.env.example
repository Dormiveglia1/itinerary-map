# Copy to .env (git-ignored) and fill in. Never commit .env.
# Server key with Places API (New) + Routes API enabled. Ask Shaoyuan privately.
GOOGLE_MAPS_API_KEY=

# Frontend dev server origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Module under src/ exposing generate_itinerary(trip, pois, travel_times)
OPTIMIZER_MODULE=optimization
